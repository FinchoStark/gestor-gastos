# Copia este fichero a .env y rellena los valores.

# PostgreSQL (local con Docker o la cadena de conexión de Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastos

# IA: sin clave la app funciona en MODO DEMO (datos inventados)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# AWS S3 para las fotos (opcional en local, necesario en Vercel para guardarlas)
S3_BUCKET=
S3_REGION=eu-south-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
